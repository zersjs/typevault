{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TYPEVAULT",
  "version": "1.0.0",
  "identifier": "com.typevault.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TYPEVAULT",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 20 },
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' tvfont:; font-src 'self' tvfont: data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost tvfont:",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline' tvfont:; font-src 'self' tvfont: data:; img-src 'self' data:; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost tvfont: ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "TYPEVAULT",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
